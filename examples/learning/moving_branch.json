  "model": {
    "schema": "fieldbridge-memory/1",
    "name": "Moving branch of a cubic drift",
    "kind": "equations",
    "question": "What term appears when a coordinate is measured relative to a moving branch?",
    "provenance": {"kind": "authored verification example", "source": "Algebraic translation of a cubic drift; this example tests equations, not a chemical implementation"},
