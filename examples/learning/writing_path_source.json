{
  "schema": "fieldbridge-stochastic-passage/1",
  "model": {
    "schema": "fieldbridge-memory/1",
    "kind": "equations",
    "name": "coupled_amplitudes",
    "question": "Predict the final basin probabilities after a finite-rate write and a force-free hold",
    "assumptions": [
      "overdamped polynomial amplitudes",
      "additive Ito Brownian noise"
    ],
    "provenance": {
      "kind": "constructed drift used in the 20261018 autonomous-search follow-up",
      "source": "run_nb_and_fb3d_fast.py, eval_3d_regime_job; corrected anisotropy interpretation"
