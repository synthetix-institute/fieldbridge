    ],
    "covariance": [
      [
        0.0001,
        0.0,
        0.0
      ],
      [
        0.0,
        0.0002,
        0.0
      ],
      [
        0.0,
        0.0,
        0.0001
      ]
    ]
  },
  "hold_diffusion": 1e-05,
  "relax_time": 80.0,
