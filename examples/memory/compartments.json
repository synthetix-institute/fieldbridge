{
  "schema": "fieldbridge-memory/1",
  "question": "How long does a three-compartment exchange retain an imbalance that the observed compartment does not show?",
  "provenance": {
    "source": "Hyperion three-compartment model (companion manuscript)",
    "kind": "authored example"
  },
  "field": "compartment models",
  "kind": "equations",
  "name": "three compartments with an unobserved imbalance",
  "carrier": {
    "kind": "euclid",
    "name": "observable x and unobserved imbalance z",
    "variables": [
      "x",
      "z"
    ],
    "scale": 0.3
  },
  "parameters": {
    "ax": 7.5,
    "az": 3.9,
    "b": 1.5,
    "c": 4.5
  },
  "drift": {
    "x": "-ax*x + b*z",
    "z": "c*x - az*z"
  },
  "noise": 0.02,
  "dt": 0.002,
  "closure": "probability conserved; symmetric exchange",
  "observable": "return of material to compartment 0",
  "assumptions": [
    "linear exchange",
    "x = p0 - 1/3, z = p1 - p2"
  ]
}
