{
  "schema": "fieldbridge-memory/1",
  "question": "Can a flow network remember which of two tubes carried the flow?",
  "provenance": {
    "source": "Tero, Kobayashi and Nakagaki, J. Theor. Biol. 244, 553 (2007)",
    "kind": "authored example"
  },
  "field": "transport networks",
  "kind": "equations",
  "name": "adaptive transport network, two tubes",
  "carrier": {
    "kind": "orthant",
    "name": "tube conductances",
    "variables": [
      "D1",
      "D2"
    ],
    "scale": 1
  },
  "parameters": {
    "mu": 2.0,
    "L1": 1.0,
    "L2": 1.0
  },
  "drift": {
    "D1": "abs((D1/L1)/(D1/L1 + D2/L2))**mu/(1 + abs((D1/L1)/(D1/L1 + D2/L2))**mu) - D1",
    "D2": "abs((D2/L2)/(D1/L1 + D2/L2))**mu/(1 + abs((D2/L2)/(D1/L1 + D2/L2))**mu) - D2"
  },
  "control": {
    "name": "mu",
    "range": [
      0.5,
      3.0
    ]
  },
  "material": [
    "L2"
  ],
  "noise": 0.005,
  "dt": 0.02,
  "closure": "fixed total flux between a source and a sink (Kirchhoff)",
  "observable": "which tube carries the flow",
  "assumptions": [
    "sigmoidal reinforcement f(Q) = Q^mu/(1+Q^mu)",
    "dimensionless conductances"
  ]
}
