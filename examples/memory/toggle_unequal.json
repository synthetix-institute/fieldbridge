{
  "schema": "fieldbridge-memory/1",
  "question": "What changes when one promoter of the toggle is stronger than the other?",
  "provenance": {
    "source": "Gardner, Cantor and Collins, Nature 403, 339 (2000)",
    "kind": "authored example"
  },
  "field": "synthetic biology",
  "kind": "equations",
  "name": "genetic toggle, unequal promoters",
  "carrier": {
    "kind": "orthant",
    "name": "repressor concentrations",
    "variables": [
      "u",
      "v"
    ],
    "scale": 4
  },
  "parameters": {
    "alpha": 4.0,
    "n": 2.0,
    "gamma": 1.25
  },
  "drift": {
    "u": "alpha/(1 + v**n) - u",
    "v": "gamma*alpha/(1 + u**n) - v"
  },
  "control": {
    "name": "alpha",
    "range": [
      0.5,
      6.0
    ]
  },
  "material": [
    "gamma"
  ],
  "noise": 0.05,
  "dt": 0.01,
  "closure": "well-mixed cell with dilution",
  "observable": "which repressor is high",
  "assumptions": [
    "dimensionless concentrations and time",
    "promoter of v stronger by the factor gamma",
    "additive Gaussian noise"
  ]
}
