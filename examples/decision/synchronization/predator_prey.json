{
  "schema": "fieldbridge-decision/1",
  "kind": "oscillators",
  "target": "synchronization",
  "name": "Population of rosenzweig-MacArthur predator and prey",
  "field": "ecology",
  "question": "At which coupling, and how fast, does a population of these units synchronize?",
  "assumptions": [
    "the unit of examples/memory/oscillators/predator_prey.json at cap = 3",
    "a Gaussian spread of cap that spreads the frequencies by 1% of their mean",
    "all-to-all diffusive coupling through pred acting on pred"
  ],
  "provenance": {
    "source": "Rosenzweig and MacArthur, Am. Nat. 97, 209 (1963)",
    "kind": "published model"
  },
  "carrier": {
    "kind": "orthant",
    "name": "prey and predator densities",
    "variables": [
      "prey",
      "pred"
    ],
    "scale": 3.0
  },
  "parameters": {
    "cap": 3.0,
    "conv": 0.5,
    "mort": 0.2
  },
  "drift": {
    "prey": "prey*(1 - prey/cap) - prey*pred/(1 + prey)",
    "pred": "pred*(conv*prey/(1 + prey) - mort)"
  },
  "control": {
    "name": "cap",
    "range": [
      1.5,
      4.0
    ]
  },
  "population": {
    "heterogeneity": {
      "parameter": "cap",
      "density": "gaussian",
      "centre": 3.0,
      "spread": 0.01
    },
    "coupling": {
      "through": "pred",
      "acting_on": "pred",
      "factors": [
        1.5,
        2.5
      ]
    }
  },
  "expect": "synchronizes"
}
